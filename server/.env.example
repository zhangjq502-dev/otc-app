# Copy to server/.env. Never commit credentials.
NODE_ENV=production
PORT=3700
DATABASE_URL=postgresql://user:password@host:5432/otc
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_TOKEN=
# Comma separated web origins; native clients do not require CORS.
CORS_ORIGINS=http://localhost:5173
# Keep false for normal deployments. Demo data is only inserted into empty storage.
SEED_DEMO_DATA=false
SIMULATE_MERCHANT=false

# Set 1 only when running behind one trusted proxy, e.g. Render.
TRUST_PROXY_HOPS=0

# Optional private CA PEM, supports literal \n; do not include SSL query parameters in DATABASE_URL with this option.
DATABASE_CA_CERT=

# Initial admin password; applies only when the reserved admin account is first created.
ADMIN_PASSWORD=123456
